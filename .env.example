AUDIO_ONLY_DEFAULT=true

# Scheduler + onboarding
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SEC=30
DEFAULT_TIMEZONE=UTC
ONBOARDING_SAMPLES=10

